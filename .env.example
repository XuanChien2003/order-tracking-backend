NODE_ENV=development
PORT=8080
MONGO_URI=mongodb+srv://<user>:<password>@<cluster-host>/<db-name>
JWT_SECRET=<generate-a-random-secret-eg-openssl-rand-hex-32>
JWT_EXPIRES_IN=1d
VTP_WEBHOOK_TOKEN=<shared-secret-agreed-with-vtp>

# Dev/CI only - never set ENABLE_AUTO_SEED=true in production. Seeding is skipped entirely
# unless both this is "true" AND NODE_ENV is not "production".
ENABLE_AUTO_SEED=false
SEED_ADMIN_PASSWORD=<choose-a-password-for-the-seeded-admin-account>
SEED_SCANNER_PASSWORD=<choose-a-password-for-the-seeded-scanner-account>

# Comma-separated list of origins allowed to call this API (web admin, local dev servers, etc.)
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:8081

# Used to email generated login credentials to a partner when admin creates their account
# (POST /partners). If unset, that account creation still succeeds but the email step is skipped
# with emailSent=false in the response. Sent over HTTPS via Resend (resend.com) rather than raw
# SMTP - Render blocks outbound SMTP ports (25/465/587), so a direct SMTP connection never works
# there regardless of configuration. Get a free API key at https://resend.com/api-keys.
RESEND_API_KEY=<your-resend-api-key>
# Without a verified sending domain on Resend, this must stay onboarding@resend.dev (Resend's
# shared sandbox address) - switch it only after verifying your own domain there.
EMAIL_FROM=onboarding@resend.dev
