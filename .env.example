NODE_ENV=development
PORT=8080
MONGO_URI=mongodb+srv://<user>:<password>@<cluster-host>/<db-name>
JWT_SECRET=<generate-a-random-secret-eg-openssl-rand-hex-32>
JWT_EXPIRES_IN=1d
VTP_WEBHOOK_TOKEN=<shared-secret-agreed-with-vtp>

# Dev/CI only - never set ENABLE_AUTO_SEED=true in production. Seeding is skipped entirely
# unless both this is "true" AND NODE_ENV is not "production".
ENABLE_AUTO_SEED=false
SEED_ADMIN_PASSWORD=<choose-a-password-for-the-seeded-admin-account>
SEED_SCANNER_PASSWORD=<choose-a-password-for-the-seeded-scanner-account>

# Comma-separated list of origins allowed to call this API (web admin, local dev servers, etc.)
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:8081

# Geofence for nhap_kho/xuat_kho scans (POST /scans) - App PDA must be within this radius of the
# warehouse to record those two event types (ban_giao and tra_cuu are exempt, see scan.service.js).
# Defaults (in env.js) point at the Viettel Post Hanoi warehouse if these are left unset.
WAREHOUSE_LAT=21.0097723
WAREHOUSE_LNG=105.8503157
WAREHOUSE_RADIUS_M=150

# Used to email generated login credentials to a partner when admin creates their account
# (POST /partners). If unset, that account creation still succeeds but the email step is skipped
# with emailSent=false in the response. Sent over HTTPS via SendGrid rather than raw SMTP - Render
# blocks outbound SMTP ports (25/465/587), so a direct SMTP connection never works there regardless
# of configuration. Get a free API key at https://app.sendgrid.com/settings/api_keys.
SENDGRID_API_KEY=<your-sendgrid-api-key>
# Must be an email verified via SendGrid's "Single Sender Verification" (Settings > Sender
# Authentication) - unlike Resend, this does NOT require owning/verifying a whole domain, just
# clicking a confirmation link sent to this address.
EMAIL_FROM=<your-single-sender-verified-email>
